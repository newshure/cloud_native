# =============================================================================
# Force LF line endings for files used inside Linux containers / Kubernetes.
# Without this, Windows checkouts produce CRLF which breaks bash shebang
# (#!/bin/bash\r) and YAML parsers in some environments.
# =============================================================================

# Default: auto-detect text vs binary
* text=auto

# Always LF — required for container execution / CI parsing
*.sh        text eol=lf
*.bash      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
*.conf      text eol=lf
Dockerfile  text eol=lf
Makefile    text eol=lf

# Markdown / docs: keep LF for consistency
*.md        text eol=lf

# Binary types — never auto-convert
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.dump      binary
*.tar       binary
*.tar.gz    binary
*.zip       binary
